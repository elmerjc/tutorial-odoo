<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Registro del Reporte PDF en el menú Imprimir -->
    <record id="action_report_gestion_vehiculo" model="ir.actions.report">
        <field name="name">Ficha del Vehículo</field>
        <field name="model">gestion.vehiculo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_vehiculos.report_vehiculo_document</field>
        <field name="report_file">gestion_vehiculos.report_vehiculo_document</field>
        <field name="print_report_name">'Ficha_Vehiculo_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_gestion_vehiculo"/>
        <field name="binding_type">report</field>
    </record>
</odoo>