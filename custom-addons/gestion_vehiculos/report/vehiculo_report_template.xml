<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_vehiculo_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <main>
                    <div class="page">
                        <!-- Encabezado del Documento -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>Ficha Técnica de Vehículo</h2>
                                <h4 class="text-muted">Placa / Matrícula: <t t-esc="doc.name"/></h4>
                            </div>
                            <div class="col-4 text-end">
                                <t t-if="doc.image_1920">
                                    <img t-att-src="image_data_uri(doc.image_1920)" style="max-height: 120px; max-width: 150px; border-radius: 5px; border: 1px solid #ccc;"/>
                                </t>
                            </div>
                        </div>

                        <!-- Datos Principales -->
                        <table class="table table-bordered mb-4">
                            <tbody>
                                <tr>
                                    <th class="bg-light" style="width: 20%;">Marca:</th>
                                    <td><t t-esc="doc.marca"/></td>
                                    <th class="bg-light" style="width: 20%;">Modelo:</th>
                                    <td><t t-esc="doc.modelo"/></td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Año:</th>
                                    <td><t t-esc="doc.anio"/></td>
                                    <th class="bg-light">Estado:</th>
                                    <td>
                                        <span class="badge bg-info text-dark" t-esc="doc.estado"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Conductor:</th>
                                    <td colspan="3">
                                        <t t-if="doc.conductor_id">
                                            <t t-esc="doc.conductor_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <em>Sin conductor asignado</em>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Historial de Mantenimientos -->
                        <h4 class="mt-4">Historial de Mantenimientos</h4>
                        <t t-if="doc.mantenimiento_ids">
                            <table class="table table-sm table-striped table-bordered mt-2">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Descripción</th>
                                        <th>Foto Ingreso</th>
                                        <th>Foto Salida</th>
                                        <th class="text-end">Costo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.mantenimiento_ids" t-as="m">
                                        <tr>
                                            <td><t t-esc="m.fecha"/></td>
                                            <td><t t-esc="m.name"/></td>
                                            <td class="text-center">
                                                <t t-if="m.foto_ingreso">
                                                    <img t-att-src="image_data_uri(m.foto_ingreso)" style="max-height: 40px;"/>
                                                </t>
                                            </td>
                                            <td class="text-center">
                                                <t t-if="m.foto_salida">
                                                    <img t-att-src="image_data_uri(m.foto_salida)" style="max-height: 40px;"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="m.costo" t-options='{"widget": "monetary", "display_currency": m.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="row justify-content-end mt-2">
                                <div class="col-4 text-end">
                                    <strong>Gasto Total Taller: </strong>
                                    <span t-esc="doc.costo_total_mantenimiento" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No existen registros de mantenimiento para este vehículo.</p>
                        </t>

                        <!-- Observaciones -->
                        <t t-if="doc.notas">
                            <h5 class="mt-4">Notas Adicionales</h5>
                            <p class="border p-2 rounded bg-light" t-esc="doc.notas"/>
                        </t>
                    </div>
                </main>
            </t>
        </t>
    </template>

</odoo>